{
  "name": "clawface",
  "private": true,
  "version": "0.15.0",
  "description": "Desktop-first OpenClaw client for sessions, tools, files, media, and memory visibility.",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "node --test tests/*.test.mjs",
    "desktop:build:web": "vite build",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run desktop:build:web && electron-builder --dir",
    "desktop:dist:mac": "npm run desktop:build:web && electron-builder --mac dmg zip --arm64 --publish never",
    "desktop:dist:mac:x64": "npm run desktop:build:web && electron-builder --mac dmg zip --x64 --publish never",
    "desktop:dist:win": "npm run desktop:build:web && electron-builder --win nsis zip --x64 --publish never",
    "desktop:dist:linux": "npm run desktop:build:web && electron-builder --linux AppImage deb rpm --x64 --publish never",
    "preview": "vite preview",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:rollup-linux": "node -e \"require.resolve('@rollup/rollup-linux-x64-gnu')\"",
    "check:env": "npm run check:runtime && npm run check:rollup-linux",
    "verify:ci": "npm ci && npm run check:env && npm run build",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "dompurify": "^3.3.3",
    "katex": "^0.16.28",
    "marked": "^12.0.2",
    "marked-katex-extension": "^5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "electron": "^40.8.5",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^8.0.8"
  },
  "build": {
    "appId": "com.openclaw.para",
    "productName": "ClawFace",
    "icon": "public/clawface-logo.png",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "public/clawface-logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "icon": "public/clawface-logo.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "icon": "public/clawface-logo.png",
      "maintainer": "ClawFace maintainers",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
